---
import { ClientRouter } from "astro:transitions";
import "@fontsource-variable/inter";
import { Image } from "astro:assets";
import Footer from "~/components/footer.astro";
import Header from "~/components/header.astro";
import "~/styles/index.css";
import { fade } from "astro:transitions";
import "aos/dist/aos.css";

import heroRight from "~/assets/emplo_trends_hero.webp";
import heroMobile from "~/assets/emplo_trends_hero.webp";

const { generator, site } = Astro;
const title = "Exanta P.C. - Employment Trends";
const image = new URL("social.jpg", site);
const pageTitle = "exanta - Employment Trends";
const description = "Exanta P.C. - Employment Trends";
---

<html lang="en" class="h-full motion-safe:scroll-smooth" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={generator} />
    <ClientRouter />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <!-- plausible code -->
    <script
      defer
      data-domain="exanta.io"
      src="https://analytics.csd.auth.gr/js/script.js"></script>

    <!-- social media -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:type" content="website" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={site} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Animate on scroll library  -->
    <script>
      import AOS from "aos";
      AOS.init();
    </script>
  </head>
  <body
    class="h-full overflow-x-hidden bg-slate-950 text-default text-base selection:bg-secondary selection:text-white"
  >
    <Header />
    <div>
      <div class="bg-gradient-to-b from-slate-950 to-slate-800 mt-32">
        <!-- hero section -->
        <section
          id="emplotrends-hero"
          class="hidden lg:flex scroll-mt-24 items-center justify-around gap-4 space-y-8 h-fit 2xl:mx-auto 2xl:ms-32"
        >
          <div
            class="flex flex-row items-center justify-between space-y-0 gap-x-4 xl:gap-x-32 space-x-8"
          >
            <div class="flex-1 flex-col items-center gap-4 ps-32">
              <slot name="eyebrow" />
              <h1
                class="text-sky-400 text-left font-extrabold tracking-tight text-6xl"
              >
                Employment Trends Across Europe
              </h1>
              <p class="max-w-3xl text-left font-extrabold text-xl">
                <slot name="lead" />
                <span class="text-[#94A3B8]"
                  >Explore. Compare. Understand employment across Europe.
                </span><slot />
              </p>
            </div>
            <div
              data-aos="fade-left"
              data-aos-duration="1500"
              class="flex-0 text-left max-w-screen-md"
            >
              <Image
                transition:animate={fade({ duration: "1.4s" })}
                slot="eyebrow"
                src={heroRight}
                alt="ecogazer image"
                class="max-w-[600px] pe-24"
              />
            </div>
          </div>
        </section>
        <!-- hero section mobile screens -->
        <section
          id="aiactchecker-hero-mob"
          class="lg:hidden scroll-mt-24 items-center flex-col gap-4 space-y-8 h-fit px-8"
        >
          <div class="flex flex-col items-center space-y-8">
            <div>
              <div class="flex-1 flex-col items-center gap-4">
                <slot name="eyebrow" />
                <h1
                  class="text-sky-400 text-center font-extrabold tracking-tight text-6xl max-w-[600px] mx-auto"
                >
                  Employment Trends Across Europe
                </h1>
              </div>
              <p class="max-w-3xl text-center font-extrabold text-xl">
                <slot name="lead" />
                <span class="text-[#94A3B8]"
                  >Explore. Compare. Understand employment across Europe.
                </span><slot />
              </p>
            </div>
            <div
              data-aos="fade-down"
              data-aos-duration="1500"
              class="flex-1 text-center"
            >
              <Image
                transition:animate={fade({ duration: "1.4s" })}
                slot="eyebrow"
                src={heroMobile}
                alt="ecogazer image"
                class="sm:max-w-[500px]"
              />
            </div>
          </div>
        </section>
        <!-- intro and features section -->
        <section
          class="container px-8 lg:px-2 py-8 flex flex-col lg:flex-row scroll-mt-24 justify-around gap-4 h-fit mx-auto max-w-5xl"
        >
          <div class="flex-0">
            <h2 class="text-gray-100 text-center font-extrabold text-2xl">
              Turning Employment Data into Insights
            </h2>
            <p class="text-center text-sm text-[#94A3B8] py-4">
              Employment Trends is an interactive dashboard designed to help
              users explore how employment evolves across the EU-27. From youth
              unemployment and part-time work to NEET and temporary employment,
              the tool brings together key indicators to provide a clear and
              data-driven picture of the labor market. With visualizations and
              searchable tables, it makes complex employment statistics
              accessible, comparable, and actionable.
            </p>
          </div>
        </section>

        <!-- core features section -->
        <div
          class="-mt-5 lg:-mt-12 relative w-full h-32 lg:h-96 bg-white mx-auto my-0"
          style="top: 1px; clip-path: polygon(100% 0%, 100% 100%, 0 100%)"
        >
        </div>
        <section class="bg-white py-12 pb-44 px-8">
          <div
            class="container pt-12 text-center max-w-5xl mx-auto bg-white -mt-12 xl:-mt-16"
          >
            <h2 class="text-sky-400 font-bold text-2xl">
              Start Exploring Employment Trends Today
            </h2>
            <p class="text-sm text-[#94A3B8] pt-4">
              Uncover the dynamics shaping Europe’s labor market. Whether you’re
              a researcher, policymaker, or citizen, Employment Trends helps you
              navigate data with clarity and confidence.
            </p>
            <a href="https://emplo-trends.exanta.app/" target="_blank"
              ><button
                class="flex mx-auto mt-12 items-center justify-center gap-3 border-2 border-slate-950 text-slate-950 hover:bg-slate-950 px-6 py-4 hover:text-[#FFFFFF]"
              >
                Visit Demo
              </button></a
            >
          </div>
        </section>
      </div>
    </div>
    <Footer />
  </body>
</html>
